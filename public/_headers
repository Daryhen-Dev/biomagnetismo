# Cabeceras para Cloudflare Pages.
# Cloudflare lee este archivo desde el directorio de salida (`dist/`), así que
# Astro lo copia desde `public/` en cada build, igual que `_redirects`.
#
# No se define Content-Security-Policy a propósito: el visor de fotos y la
# fachada de video abren YouTube (youtube-nocookie.com) y una CSP mal calibrada
# los rompería en silencio. Si se agrega más adelante, tiene que incluir
# frame-src https://www.youtube-nocookie.com y img-src https://i.ytimg.com.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Los archivos de /_astro/ llevan hash en el nombre: cambian cuando cambia el
# contenido, así que se pueden cachear para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon-32.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
