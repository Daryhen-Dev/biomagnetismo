---
/**
 * Estructura común de todas las páginas.
 *
 * Qué renderiza: el documento entero — `<head>` con SEO, enlace para saltar al
 * contenido, barra superior, `<main>` con el contenido de la página y pie.
 *
 * De dónde sale cada cosa:
 * - Nombre del sitio, descripción y navegación: `src/data/site.ts`
 * - Contacto real: `src/data/contact.ts`
 * - Colores, tipografías y espaciados: `src/styles/global.css` + `DESIGN.md`
 *
 * Qué tocar para…
 * - cambiar el título o la descripción de UNA página → el frontmatter de su
 *   `.md` en `src/content/pages/`, o el `<BaseLayout>` de su ruta
 * - cambiar el menú → `src/data/site.ts`
 * - cambiar el pie → `src/components/SiteFooter.astro`
 * - cambiar el movimiento (revelado, barra, dibujo del par) →
 *   `src/components/SiteMotion.astro`
 * - cambiar la imagen que se comparte al pegar el enlace → `ogImage`
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteMotion from "../components/SiteMotion.astro";
import { contact, directorPortrait } from "../data/contact";
import { cloudflareBeaconToken, siteDescription, siteLocale, siteName } from "../data/site";

import archivoFont from "../styles/fonts/archivo.woff2?url";
import spectralFont from "../styles/fonts/spectral-600.woff2?url";

interface Props {
  /** Título de la página. El nombre del sitio se agrega solo. */
  title: string;
  description?: string;
  /** Imagen para Open Graph. Por defecto, el retrato del director. */
  ogImage?: ImageMetadata;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = siteDescription,
  ogImage = directorPortrait,
  ogType = "website",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://centrodoctorgoiz.cl");
const canonical = new URL(Astro.url.pathname, site).href;
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const ogImageUrl = new URL(ogImage.src, site).href;

// Ficha del negocio para buscadores. Solo hechos verificables: dirección,
// teléfono y horario reales. Sin valoraciones ni especialidades inventadas.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: siteName,
  description: siteDescription,
  url: site.href,
  telephone: contact.whatsapps[0].label,
  email: contact.emails[0],
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressCountry: "EC",
  },
  // Dos franjas de lunes a viernes: el mediodía queda cerrado y no se puede
  // declarar un horario continuo.
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:30",
      closes: "13:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "14:30",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "09:30",
      closes: "13:00",
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#090e19" />

    <link rel="preload" href={spectralFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />

    <!-- Favicon y icono de app: el sello real del centro, no un dibujo. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {
      import.meta.env.PROD && cloudflareBeaconToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken })}
        />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={siteLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content="Francisco Mena Flores, director del centro" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <SiteMotion />
  </body>
</html>
