---
/**
 * PLANTILLA DE LAS PÁGINAS INSTITUCIONALES
 *
 * Qué renderiza: una sola plantilla sirve las siete páginas de contenido
 * (el método, el doctor, servicios, preguntas, testimonios, entrevistas y
 * colaboradores). Tres partes:
 *
 * 1. Portada de página: miga de pan, título grande y entrada. En escritorio el
 *    título ocupa la columna ancha y la entrada la angosta: la página usa el
 *    ancho disponible sin estirar el texto de lectura.
 * 2. Cuerpo: barra lateral pegajosa con el índice de la página (izquierda) y
 *    la columna de lectura con el texto agrupado (`.prose`). El ancho de lectura
 *    lo fija `--measure`; lo que sobra a la derecha es el margen de las
 *    imágenes grandes (`grid-column: 1 / -1` en `.prose > .pullout`).
 * 3. Cierre con WhatsApp.
 *
 * En la página del doctor, los documentos que cierran el texto salen del
 * cuerpo y forman un muro a todo el ancho (`.doc-wall`): catorce diplomas
 * apilados en una columna de lectura no se leen.
 *
 * De dónde sale el contenido: `src/content/pages/<slug>.md`. El nombre del
 * archivo es la URL, salvo que la página tenga su propia ruta (la portada, la
 * galería y contactos no pasan por acá: ver `HANDLED_ELSEWHERE`).
 *
 * Qué tocar:
 * - el texto de una página → su `.md` en `src/content/pages/`
 * - la entrada, la descripción para buscadores y el tratamiento → `pageMeta`
 *   en `src/data/page-meta.ts`
 * - cómo se agrupa el cuerpo y qué entra al índice → `BODY_TREATMENTS` y
 *   `groupBlocks()` en `src/data/content-html.ts`
 * - cómo se ve el texto corrido → bloque `.prose` en `src/styles/global.css`
 * - el botón final → `src/components/PageCta.astro`
 */
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageCta from "../components/PageCta.astro";
import EntryBody from "../components/EntryBody.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import FieldRule from "../components/FieldRule.astro";
import { pageMeta } from "../data/page-meta";
import { BODY_TREATMENTS } from "../data/content-html";
import { directorPortrait } from "../data/contact";
import {
  normalizeHeadingLevels,
  outlineFor,
  renderEntryHtml,
  splitTrailingImages,
  toBlocks,
} from "../data/content-html";

export async function getStaticPaths() {
  // Páginas con ruta propia: la portada (`index.astro`), el índice de galerías
  // y contactos se sirven desde sus propios archivos.
  const HANDLED_ELSEWHERE = new Set(["home", "galeria", "contactos"]);
  const pages = await getCollection("pages");

  return pages
    .filter((page) => !HANDLED_ELSEWHERE.has(page.id))
    .map((page) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const meta = pageMeta[page.id];

if (!meta) {
  throw new Error(
    `La página "${page.id}" no tiene entrada en src/data/page-meta.ts. ` +
      `Agregala ahí para definir su entrada visible y su descripción para buscadores.`,
  );
}

const { Content } = await render(page);

// El cuerpo se renderiza una vez y se trabaja por bloques: agrupar para
// componer en columnas, cortar el muro de documentos e indexar los grupos.
const html = await renderEntryHtml(Content);
const blocks = normalizeHeadingLevels(toBlocks(html));

// Los documentos finales se componen aparte, a todo el ancho.
const { body, wall } =
  meta.variant === "documentos" ? splitTrailingImages(blocks) : { body: blocks, wall: [] };

const outline = outlineFor(body, meta.variant);

const proseClass = meta.variant === "ninguno" ? "prose" : `prose prose--${meta.variant}`;
// Barra lateral: solo cuando el cuerpo es una sola columna de lectura y hay más
// de un destino al que saltar. En las páginas de lista (preguntas, método,
// entrevistas…) el cuerpo va a dos columnas y la lista es su propio índice.
const showRail = outline.length >= 2 && !BODY_TREATMENTS[meta.variant].columns;
---

<BaseLayout
  title={page.data.title}
  description={meta.description}
  ogImage={meta.portrait ? directorPortrait : undefined}
>
  <section class="page-intro band band--night">
    <div class="shell page-intro__grid">
      <nav class="page-intro__trail" aria-label="Ubicación en el sitio">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>{meta.sectionLabel}</span>
        <span aria-hidden="true">/</span>
        <span>{page.data.title}</span>
      </nav>

      <h1 class="page-intro__title">{page.data.title}</h1>

      <div class="page-intro__aside">
        <p class="page-intro__lede">{meta.lede}</p>

        {
          meta.portrait && (
            <figure class="page-intro__portrait frame">
              <Image
                src={directorPortrait}
                alt="Retrato del Dr. Francisco Mena Flores."
                widths={[240, 480]}
                sizes="(min-width: 1024px) 16rem, 60vw"
              />
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <section class="band band--paper band--article">
    <div class:list={["shell", "article__grid", showRail && "article__grid--railed"]}>
      {
        showRail && (
          <aside class="article__rail">
            <nav class="article__index" aria-labelledby="indice-pagina">
              <p class="article__index-title" id="indice-pagina">
                En esta página
              </p>
              <ol class="article__index-list">
                {outline.map((item) => (
                  <li>
                    <a class="article__index-link" href={`#${item.id}`}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }

      <div class="article__body">
        <div class={proseClass}>
          <EntryBody blocks={body} variant={meta.variant} />
        </div>

        {
          page.data.videos.length > 0 && (
            <section class="videos" aria-label="Videos">
              {page.data.videos.map((video) => (
                <VideoEmbed id={video.id} title={video.title} description={video.description} />
              ))}
            </section>
          )
        }

        {
          meta.notice && (
            <aside class="notice" data-reveal>
              <p class="notice__title">{meta.notice.title}</p>
              <p class="notice__body">{meta.notice.body}</p>
            </aside>
          )
        }
      </div>
    </div>
  </section>

  {
    wall.length > 0 && (
      <section class="band band--paper-raised doc-band">
        <div class="shell">
          <FieldRule />
          <div class="doc-wall" data-reveal-group>
            {wall.map((image) => (
              <div class="doc-wall__cell frame" data-reveal>
                <Fragment set:html={image} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <PageCta
    title={meta.cta.title}
    body={meta.cta.body}
    message={meta.cta.message}
    secondary={{ label: "Volver al inicio", href: "/" }}
  />
</BaseLayout>
