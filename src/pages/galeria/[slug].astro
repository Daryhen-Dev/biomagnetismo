---
/**
 * GALERÍA DE UN PAÍS O EVENTO — /galeria/<archivo>/
 *
 * Qué renderiza: la portada de la galería (imagen del país y las notas de
 * archivo que traía el sitio original), el índice de sus álbumes y cada álbum
 * con sus fotos.
 *
 * De dónde sale: `src/content/galleries/<archivo>.json`. Cada archivo del
 * contenido produce una página; el nombre del archivo es la URL. Las fotos se
 * resuelven con `astro:assets` desde `src/data/gallery-media.ts`, y el texto de
 * la introducción se interpreta con `src/data/gallery-intro.ts` porque viene en
 * Markdown dentro de JSON.
 *
 * Qué tocar:
 * - agregar o quitar fotos → el `.json` de esa galería (campo `galleries`)
 * - el texto de la introducción → campo `intro` del mismo `.json`
 * - el orden de las galerías y el enlace "siguiente" → `src/data/gallery-order.ts`
 * - la grilla → `.gallery-grid` en `src/styles/global.css`
 *
 * Composición: un álbum que no llena una fila de la hoja de contactos (una o dos
 * fotos) recibe `album--few` y la cuenta en `--album-count`; sus fotos conservan
 * el tamaño de siempre y el rótulo del álbum ocupa las pistas que sobran. El
 * cierre de la página compone los dos destinos en dos columnas, cada uno con su
 * cuenta real.
 *
 * Pendiente conocido: 245 de las 254 fotos llevan texto alternativo generado
 * (`altPending: true`). Antes de publicar hay que revisarlo; se cambia en el
 * JSON de la galería.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import GalleryViewer from "../../components/GalleryViewer.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import FieldRule from "../../components/FieldRule.astro";
import { mediaImage, mediaImageOrUndefined } from "../../data/gallery-media";
import { parseGalleryIntro } from "../../data/gallery-intro";
import { gallerySize, sortGalleries } from "../../data/gallery-order";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");

  return galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const intro = parseGalleryIntro(gallery.data.intro);
const size = gallerySize(gallery);

const sorted = sortGalleries(await getCollection("galleries"));
const position = sorted.findIndex((entry) => entry.id === gallery.id);
const nextGallery = sorted.length > 1 ? sorted[(position + 1) % sorted.length] : undefined;

// Cuentas reales del archivo completo y de la galería siguiente: son el dato
// que acompaña a cada enlace del cierre. Se calculan una vez.
const totals = sorted.reduce(
  (accumulator, entry) => {
    const entrySize = gallerySize(entry);
    return {
      albums: accumulator.albums + entrySize.albums,
      photos: accumulator.photos + entrySize.photos,
    };
  },
  { albums: 0, photos: 0 },
);
const nextSize = nextGallery ? gallerySize(nextGallery) : undefined;
---

<BaseLayout
  title={gallery.data.title}
  description={`Archivo fotográfico: ${gallery.data.title}. ${size.albums} ${
    size.albums === 1 ? "álbum" : "álbumes"
  } con ${size.photos} fotos del Centro de Biomagnetismo Médico.`}
  ogImage={mediaImage(gallery.data.cover)}
  ogType="article"
>
  <section class="page-intro band band--night">
    <div class="shell page-intro__grid gallery-intro">
      <nav class="page-intro__trail" aria-label="Ubicación en el sitio">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/galeria/">Galería</a>
        <span aria-hidden="true">/</span>
        <span>{gallery.data.title}</span>
      </nav>

      <h1 class="page-intro__title">{gallery.data.title}</h1>

      <div class="page-intro__aside">
        <p class="page-intro__lede">
          {size.albums}
          {size.albums === 1 ? "álbum" : "álbumes"} · {size.photos} fotos
        </p>
      </div>

      <!-- Portada del álbum: la foto que el sitio original usaba como
           carátula. Va más grande y con otro marco que las fotos de la grilla,
           para que la página se lea como portada + fotografías. -->
      <figure class="gallery-cover" data-reveal>
        <div class="gallery-cover__frame frame">
          <Image
            src={mediaImage(gallery.data.cover)}
            alt={`Portada del archivo ${gallery.data.title}`}
            widths={[480, 960, 1440]}
            sizes="(min-width: 64rem) 30rem, 92vw"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="gallery-cover__caption">{gallery.data.title}</figcaption>
      </figure>

      <!-- Texto de archivo: lo que el sitio original publicaba sobre esta
           galería (dónde fue el curso, a quién se atendió). -->
      {
        intro.length > 0 && (
          <div class="archive-intro" data-reveal>
            {intro.map((block) => {
              if (block.kind === "image") {
                const image = mediaImageOrUndefined(block.src);
                if (!image) return null;
                return (
                  <Image
                    class="archive-intro__image"
                    src={image}
                    alt={block.alt}
                    widths={[192, 384]}
                    sizes="12rem"
                    decoding="async"
                  />
                );
              }
              if (block.kind === "heading") {
                return (
                  <h2 class="archive-intro__heading">
                    {block.inline.map((span) =>
                      span.strong ? <strong>{span.text}</strong> : span.text,
                    )}
                  </h2>
                );
              }
              return (
                <p class:list={["archive-intro__note", !block.strong && "archive-intro__text"]}>
                  {block.inline.map((span) =>
                    span.strong ? <strong>{span.text}</strong> : span.text,
                  )}
                </p>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <GalleryViewer />

  {
    gallery.data.videos.length > 0 && (
      <section class="band band--night">
        <div class="shell">
          <div class="videos">
            {gallery.data.videos.map((video) => (
              <VideoEmbed id={video.id} title={video.title} description={video.description} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="band band--paper">
    <div class="shell">
      {
        gallery.data.galleries.length > 1 && (
          <nav class="album-index" aria-label="Álbumes de esta galería" data-reveal>
            <p class="contact-block__title">Álbumes</p>
            <div class="album-index__list" data-reveal-group>
              {gallery.data.galleries.map((album) => (
                <a class="album-index__link" href={`#${album.slug}`}>
                  <span>{album.title}</span>
                  <span class="album-index__count">{album.images.length} fotos</span>
                </a>
              ))}
            </div>
          </nav>
        )
      }

      {
        gallery.data.galleries.map((album) => {
          // Un álbum que no llena una fila de la hoja de contactos se compone
          // con su rótulo al lado de las fotos (`--album-count` es la cuenta
          // real, leída por `.album--few` en `global.css`).
          const few = album.images.length < 4;
          return (
            <section
              class:list={["album", few && "album--few"]}
              id={album.slug}
              style={few ? `--album-count:${album.images.length}` : undefined}
              data-reveal
            >
              <div class="album__head">
                <h2 class="album__title">{album.title}</h2>
                <p class="album__count">
                  {album.images.length} {album.images.length === 1 ? "foto" : "fotos"}
                </p>
              </div>
              <GalleryGrid
                images={album.images}
                album={album.title}
                albumKey={album.slug}
                eagerCount={album === gallery.data.galleries[0] ? 4 : 0}
              />
            </section>
          );
        })
      }
    </div>
  </section>

  <section class="band band--night band--compact">
    <div class="shell">
      <FieldRule />
      <nav class="album-index album-index--split" aria-label="Seguir en el archivo">
        <p class="contact-block__title">Seguir en el archivo</p>
        <div class="album-index__list">
          <a class="album-index__link" href="/galeria/">
            <span>Volver al índice de galerías</span>
            <span class="album-index__count">{totals.photos} fotos</span>
          </a>
          {
            nextGallery && nextSize && (
              <a class="album-index__link" href={`/galeria/${nextGallery.id}/`}>
                <span>Siguiente: {nextGallery.data.title}</span>
                <span class="album-index__count">
                  {nextSize.photos} {nextSize.photos === 1 ? "foto" : "fotos"}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </section>
</BaseLayout>
