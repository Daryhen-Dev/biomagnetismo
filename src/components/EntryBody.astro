---
/**
 * Cuerpo de una página de contenido, agrupado y listo para componer.
 *
 * Qué renderiza: los bloques del `.md` de la página —ya normalizados por la
 * plantilla con `src/data/content-html.ts`— separados en dos partes:
 *
 * 1. `lead`: lo que va antes del primer grupo (la entrada de la página, la foto
 *    del autor del método, la cita de definición).
 * 2. `groups`: una unidad por pregunta, concepto, sección o persona. En
 *    escritorio los grupos se componen en dos columnas (`.prose__groups`), así
 *    el texto deja de ser una cinta angosta sobre una pantalla ancha.
 *
 * Cada grupo lleva `id` para que el índice de la página (la barra lateral de
 * `src/pages/[...slug].astro`) lo enlace con `#`. La plantilla arma ese índice
 * con `outlineFor()`, que lee la misma tabla de tratamientos (`BODY_TREATMENTS`)
 * que este componente, así los dos no pueden desincronizarse.
 *
 * Lo usan: `src/pages/[...slug].astro` (con variante) y `src/pages/index.astro`
 * (sin agrupar).
 *
 * La entrada se compone según lo que traiga: si son dos piezas (título y línea)
 * va en dos columnas; si abre con una imagen suelta, la foto es la primera
 * columna y lleva su pie debajo (`.prose__lead--portrait`).
 *
 * Agregar una página nueva = agregar su tratamiento a `BODY_TREATMENTS` en
 * `src/data/content-html.ts`.
 */
import type { ContentBlock, BodyVariant } from "../data/content-html";
import { BODY_TREATMENTS, groupBlocks } from "../data/content-html";
import ContentBlocks from "./ContentBlocks.astro";

interface Props {
  blocks: ContentBlock[];
  variant?: BodyVariant;
}

const { blocks, variant = "ninguno" } = Astro.props;
const treatment = BODY_TREATMENTS[variant];
const { lead, groups } = groupBlocks(blocks, treatment.group, treatment.level);

// Una entrada que abre con una imagen suelta es una entrada con retrato: la
// foto y su pie ocupan la pista angosta y el texto sigue en la ancha.
const firstLead = lead[0];
const portraitLead =
  firstLead?.kind === "raw" && /^\s*<img\b/.test(firstLead.html);
---

{
  lead.length > 0 && (
    <div
      class:list={[
        "prose__lead",
        // Entrada de dos piezas (título + línea): en pantalla ancha se compone en
        // dos columnas, alineada con los grupos de abajo.
        treatment.splitLead && lead.length === 2 && "prose__lead--split",
        // Entrada con retrato: la foto del contenido abre la página.
        portraitLead && "prose__lead--portrait",
      ]}
      data-reveal
    >
      <ContentBlocks blocks={lead} mode={treatment.mode} />
    </div>
  )
}

{
  groups.length > 0 && (
    <div
      class:list={[
        "prose__groups",
        // La clase lleva la variante de la página, no el modo de agrupado: cada
        // página tiene su tratamiento escrito en `global.css`.
        `prose__groups--${variant}`,
        treatment.columns && "prose__groups--columns",
      ]}
      data-reveal-group
    >
      {groups.map((group) => (
        <section class="prose__group" id={group.id} data-reveal>
          <ContentBlocks blocks={group.blocks} mode={treatment.mode} />
        </section>
      ))}
    </div>
  )
}
