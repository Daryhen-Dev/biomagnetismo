---
/**
 * Placa de credenciales: retrato + títulos verificables del director.
 *
 * Qué renderiza: la foto del Dr. Francisco Mena y la lista de sus títulos con
 * institución y año. Es la prueba de confianza del sitio: la credencial real
 * (Doctor Honoris Causa) cuenta más que cualquier adjetivo.
 *
 * Lo usan: la portada y —con otra disposición— la página del doctor, que
 * hereda estos mismos datos desde `src/content/pages/francisco-mena.md`.
 *
 * Para cambiar los títulos: editá la página del doctor en el contenido y
 * repetí acá solo lo que quieras destacar en la portada.
 */
import { Image } from "astro:assets";

interface Props {
  photo: ImageMetadata;
  photoAlt: string;
  name: string;
  role: string;
  credentials: { label: string; detail: string }[];
  link?: { href: string; label: string };
}

const { photo, photoAlt, name, role, credentials, link } = Astro.props;
---

<div class="credential">
  <figure class="credential__photo">
    <Image
      src={photo}
      alt={photoAlt}
      widths={[272, 544]}
      sizes="(min-width: 768px) 17rem, 60vw"
    />
  </figure>

  <div class="credential__body">
    <h3 class="credential__name">{name}</h3>
    <p class="credential__role">{role}</p>

    <dl class="credential__list">
      {
        credentials.map((item) => (
          <div class="credential__item">
            <dt class="credential__label">{item.label}</dt>
            <dd class="credential__detail">{item.detail}</dd>
          </div>
        ))
      }
    </dl>

    {
      link && (
        <p class="credential__link">
          <a class="link-quiet" href={link.href}>
            {link.label}
          </a>
        </p>
      )
    }
  </div>
</div>
