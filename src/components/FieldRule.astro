---
/**
 * Regla divisoria con los dos polos del par.
 *
 * Qué renderiza: una línea de un píxel con un cuadrado de cobre en cada
 * extremo. Es el mismo motivo de `PairField` reducido a su forma mínima, y
 * reemplaza a la línea horizontal genérica entre secciones y entre álbumes.
 *
 * Lo usan: casi todas las plantillas. Es puramente decorativa, por eso va
 * `aria-hidden`.
 *
 * Para cambiar su color o grosor, tocá `.field-rule` en
 * `src/styles/global.css` (los colores salen de los tokens de cobre y de
 * `--rule-night` / `--rule-paper`).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["field-rule", className]} aria-hidden="true"></div>
