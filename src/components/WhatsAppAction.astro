---
/**
 * Botón de WhatsApp: el objetivo principal del sitio.
 *
 * Qué renderiza: un enlace `wa.me` con el mensaje ya escrito, el número real
 * visible y una burbuja de mensaje dibujada (no un emoji ni un icono de una
 * librería). El número aparece siempre que se pida con `showNumber`, porque
 * ver el número antes de tocar transmite que del otro lado hay alguien.
 *
 * Lo usan: portada, encabezado (escritorio), pie, página de contacto y el
 * cierre de cada página institucional.
 *
 * Para cambiar los números o los mensajes: `src/data/contact.ts`.
 * Para cambiar su aspecto: `.btn` en `src/styles/global.css`.
 */
import {
  whatsappMessages,
  whatsappUrl,
  type WhatsAppChannel,
  type WhatsAppMessageKey,
} from "../data/contact";

interface Props {
  /** Clave de `whatsappMessages`, o un texto libre ya redactado. */
  message?: WhatsAppMessageKey | string;
  label?: string;
  variant?: "copper" | "outline" | "paper";
  /** Canal a usar. Por defecto, el principal (Ecuador). */
  channel?: WhatsAppChannel;
  /** Muestra el número debajo de la etiqueta. */
  showNumber?: boolean;
  /** Ancho completo en móvil. */
  block?: boolean;
  /** Solo la burbuja, de 44 × 44 px. La etiqueta queda para lectores de pantalla. */
  compact?: boolean;
  class?: string;
}

const {
  message = "consulta",
  label = "Escribir por WhatsApp",
  variant = "copper",
  channel,
  showNumber = false,
  block = false,
  compact = false,
  class: className,
} = Astro.props;

const text = whatsappMessages[message as WhatsAppMessageKey] ?? (message as string);
const href = whatsappUrl(channel, text);
const number = channel?.label;
---

<a
  class:list={[
    "btn",
    `btn--${variant}`,
    block && "btn--block",
    compact && "btn--compact",
    className,
  ]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <path
      d="M6 3h12a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-6.2L7 20v-4H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    ></path>
  </svg>
  <span class:list={["btn__text", compact && "sr-only"]}>
    <span class="btn__label">
      {label}
      <span class="sr-only"> (se abre en una pestaña nueva)</span>
    </span>
    {showNumber && number && <span class="btn__detail">{number}</span>}
  </span>
</a>
